# Local Adobe Commerce Cloud Service (ACCS) API configuration.
# Copy this file to .env and replace the placeholders. .env is gitignored.

# REST API instance URL, without /V1 (the catalog script appends /V1).
COMMERCE_REST_BASE=https://<accs-host>/<instance-id>

# Admin/integration bearer token used by the catalog import tooling.
COMMERCE_TOKEN=<admin-or-integration-bearer-token>

# OAuth client credentials for integrations that mint a bearer token.
COMMERCE_TOKEN_URL=https://ims-na1.adobelogin.com/ims/token/v3
COMMERCE_CLIENT_ID=<client-id>
COMMERCE_CLIENT_SECRET=<client-secret>
COMMERCE_SCOPES=openid,AdobeID,additional_info.projectedProductContext,email,org.read,additional_info.roles,profile,commerce.accs

# AEM Assets author access. Bearer tokens are short-lived; refresh locally.
AEM_AUTHOR_BASE=https://author-<program>-<environment>.adobeaemcloud.com
AEM_BEARER_TOKEN=<aem-author-bearer-token>

# Optional catalog setup scope.
ROOT_CATEGORY_ID=2
